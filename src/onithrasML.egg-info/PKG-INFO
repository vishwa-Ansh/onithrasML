```text
onithrasML/
├── src/
│   └── onithrasML/
│       ├── __init__.py
│       ├── _backend/
│       ├── imputer/
│       ├── linear_model/
│       └── model_selection/
│
├── cpp/
│   ├── bindings.cpp
│   ├── decision_tree.cpp
│   ├── linear_regression.cpp
│   └── logistic_regression.cpp
│
├── tests/
├── benchmarks/
├── README.md
├── LICENSE
└── pyproject.toml
```

